# ============================================================
# CareerCopilot — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# ============================================================

# --- Application ---
APP_ENV=development                         # development | production
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info                          # debug | info | warning | error

# --- Database (Neon PostgreSQL in production) ---
# Format: postgresql+psycopg2://user:password@host:port/dbname?sslmode=require
# Get yours at: https://neon.tech → New Project → Connection Details
DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx-yyy.region.aws.neon.tech/neondb?sslmode=require

# --- Redis (Upstash in production) ---
# Format for Upstash: rediss://default:password@host:6379
# Get yours at: https://console.upstash.com → New Database → .env tab
REDIS_URL=rediss://default:your_upstash_password@your-db-name.upstash.io:6379

# --- AI: Groq (free LLM) ---
# Get yours at: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile          # fast, high-quality, free on Groq

# --- AI: Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Skill Extraction ---
SKILL_EXTRACTION_THRESHOLD=0.38            # cosine similarity cutoff (0.0 - 1.0)
SKILL_EXTRACTION_TOP_K=30                  # max skills to extract per resume

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=5

# --- Sessions ---
SESSION_TTL_DAYS=7                         # how long results stay available

# --- Rate Limiting ---
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_ROADMAP_PER_HOUR=5

# --- Monitoring (optional) ---
SENTRY_DSN=                                # leave empty to disable
