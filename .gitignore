postgres-data/
redis-data/

# Generated test fixtures (recreated by tests/fixtures/generate_fixtures.py)
test_resumes/

# Internal development files — not for public repository
.claude/
PROJECT_MEMORY.md
check_db.py
FINAL_RELEASE_CHECKLIST.md
